<?xml version="1.0" encoding="utf-8"?>
<!-- El servidor de tu casa y muchos canales usan http (sin "s"); hay que permitirlo -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
